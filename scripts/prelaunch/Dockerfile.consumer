# Disposable independent application for owner-only Agent socket acceptance.
FROM python:3.13-alpine@sha256:7415fbc3c9e4979cc717d92377ab2bc7b2b4a2af1ac03cc52b5f3f88efedaf3a
RUN apk add --no-cache openssl
WORKDIR /consumer
COPY scripts/prelaunch/static-consumer.py /consumer/static-consumer.py
USER 1002:1002
ENTRYPOINT ["python3", "-B", "/consumer/static-consumer.py"]
