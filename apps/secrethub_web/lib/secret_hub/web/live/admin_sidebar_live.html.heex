<aside
  id="admin-sidebar"
  phx-hook="AdminSidebar"
  data-collapsed="false"
  class="admin-sidebar sticky top-0 flex h-dvh w-72 shrink-0 flex-col bg-secondary text-secondary-content"
>
  <div class="admin-sidebar-brand shrink-0 px-9 py-6">
    <.dm_link
      navigate={~p"/admin/dashboard"}
      class="flex items-center gap-2 text-secondary-content"
    >
      <.dm_mdi name="shield-lock" class="h-8 w-8 shrink-0" color="currentcolor" />
      <span class="admin-sidebar-label text-xl font-bold uppercase">SecretHub</span>
    </.dm_link>
    <div class="admin-sidebar-version ml-10 mt-1">
      <.version_badge id="sidebar-version" size="sm" class="normal-case" />
    </div>
  </div>
  <div class="admin-sidebar-scroll min-h-0 flex-1 overflow-x-hidden overflow-y-auto overscroll-contain">
    <.dm_left_menu
      id="admin-sidebar-menu"
      size="md"
      active={to_string(@active_nav)}
      class="bg-secondary text-secondary-content"
    >
      <:menu>
        <.sidebar_menu_group
          title="Overview"
          active={to_string(@active_nav)}
          items={[
            %{
              id: "dashboard",
              to: ~p"/admin/dashboard",
              icon: "view-dashboard",
              label: "Dashboard"
            }
          ]}
        />

        <.sidebar_menu_group
          title="Secrets"
          active={to_string(@active_nav)}
          items={[
            %{id: "secrets", to: ~p"/admin/secrets", icon: "key-variant", label: "Secrets"},
            %{
              id: "rotators",
              to: ~p"/admin/rotators",
              icon: "rotate-3d-variant",
              label: "Rotators"
            },
            %{id: "engines", to: ~p"/admin/engines", icon: "cog", label: "Engines"},
            %{id: "rotations", to: ~p"/admin/rotations", icon: "history", label: "Rotation Logs"},
            %{id: "leases", to: ~p"/admin/leases", icon: "clock-outline", label: "Leases"}
          ]}
        />

        <.sidebar_menu_group
          title="Access Control"
          active={to_string(@active_nav)}
          items={[
            %{id: "policies", to: ~p"/admin/policies", icon: "shield-check", label: "Policies"},
            %{
              id: "ssh_access",
              to: ~p"/admin/ssh-access",
              icon: "key-chain",
              label: "SSH Access"
            },
            %{id: "approles", to: ~p"/admin/approles", icon: "account-group", label: "AppRoles"},
            %{id: "agents", to: ~p"/admin/agents", icon: "server", label: "Agents"},
            %{
              id: "pending_agents",
              to: ~p"/admin/pending-agents",
              icon: "server-plus",
              label: "Pending Agents"
            },
            %{id: "cli_access", to: ~p"/admin/cli-access", icon: "console", label: "CLI Access"}
          ]}
        />

        <.sidebar_menu_group
          title="Security"
          active={to_string(@active_nav)}
          items={[
            %{id: "audit", to: ~p"/admin/audit", icon: "eye", label: "Audit Log"}
          ]}
        />

        <.sidebar_menu_group
          title="PKI"
          active={to_string(@active_nav)}
          items={[
            %{
              id: "pki_overview",
              to: ~p"/admin/pki",
              icon: "chart-box-outline",
              label: "Overview"
            },
            %{
              id: "pki_public_trust",
              to: ~p"/admin/pki/trust-stores",
              icon: "shield-check-outline",
              label: "Public Trust"
            },
            %{
              id: "pki_acme",
              to: ~p"/admin/pki/acme",
              icon: "certificate-outline",
              label: "Public Certificates"
            },
            %{
              id: "pki_ca_list",
              to: ~p"/admin/pki/ca",
              icon: "shield-key-outline",
              label: "CA List"
            },
            %{
              id: "pki_certificates",
              to: ~p"/admin/pki/certificates",
              icon: "certificate-outline",
              label: "Certificate List"
            },
            %{
              id: "pki_certificates_issue",
              to: ~p"/admin/pki/certificates/issue",
              icon: "file-sign",
              label: "Issue Certificate"
            },
            %{
              id: "pki_csr",
              to: ~p"/admin/pki/csr",
              icon: "file-document-edit-outline",
              label: "CSR Management"
            },
            %{
              id: "pki_csr_upload",
              to: ~p"/admin/pki/csr/upload",
              icon: "upload",
              label: "Upload CSR"
            },
            %{id: "pki_search", to: ~p"/admin/pki/search", icon: "magnify", label: "Search"},
            %{
              id: "pki_analytics",
              to: ~p"/admin/pki/analytics",
              icon: "chart-line",
              label: "Analytics"
            }
          ]}
        />

        <.sidebar_menu_group
          title="Infrastructure"
          active={to_string(@active_nav)}
          items={[
            %{id: "cluster", to: ~p"/admin/cluster", icon: "server-network", label: "Cluster"},
            %{
              id: "templates",
              to: ~p"/admin/templates",
              icon: "file-document-outline",
              label: "Templates"
            },
            %{id: "alerts", to: ~p"/admin/alerts", icon: "bell", label: "Alerts"},
            %{
              id: "performance",
              to: ~p"/admin/performance",
              icon: "chart-bar",
              label: "Performance"
            }
          ]}
        />
      </:menu>
    </.dm_left_menu>
  </div>
  <div class="admin-sidebar-footer flex shrink-0 justify-end border-t border-secondary-content/20">
    <.dm_tooltip
      :let={trigger_attrs}
      id="admin-sidebar-toggle-hint"
      content="Toggle sidebar"
      position="right"
    >
      <.dm_btn
        id="admin-sidebar-toggle"
        variant="ghost"
        size="sm"
        shape="square"
        class="text-secondary-content"
        data-sidebar-toggle
        aria-controls="admin-sidebar"
        aria-expanded="true"
        aria-label="Collapse sidebar"
        {trigger_attrs}
      >
        <.dm_mdi name="chevron-left" class="admin-sidebar-collapse-icon h-5 w-5 shrink-0" />
        <.dm_mdi name="chevron-right" class="admin-sidebar-expand-icon h-5 w-5 shrink-0" />
      </.dm_btn>
    </.dm_tooltip>
  </div>
</aside>
