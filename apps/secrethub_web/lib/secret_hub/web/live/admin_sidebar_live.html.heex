<aside
  id="admin-sidebar"
  phx-hook="AdminSidebar"
  data-collapsed="false"
  class="admin-sidebar sticky top-0 flex h-dvh w-72 shrink-0 flex-col bg-secondary text-secondary-content"
>
  <div class="admin-sidebar-brand shrink-0 px-9 py-6">
    <.dm_link
      navigate={~p"/admin/dashboard"}
      class="flex items-center gap-2 text-secondary-content"
    >
      <.dm_mdi name="shield-lock" class="h-8 w-8 shrink-0" color="currentcolor" />
      <span class="admin-sidebar-label text-xl font-bold uppercase">SecretHub</span>
    </.dm_link>
    <div class="admin-sidebar-version ml-10 mt-1">
      <.version_badge id="sidebar-version" size="sm" class="normal-case" />
    </div>
  </div>
  <div class="admin-sidebar-scroll min-h-0 flex-1 overflow-x-hidden overflow-y-auto overscroll-contain">
    <.dm_left_menu
      id="admin-sidebar-menu"
      size="md"
      active={to_string(@active_nav)}
      class="bg-secondary text-secondary-content"
    >
      <:menu>
        <.dm_left_menu_group active={to_string(@active_nav)}>
          <:title>Overview</:title>
          <:menu id="dashboard" to={~p"/admin/dashboard"}>
            <.sidebar_menu_content
              id="sidebar-menu-dashboard"
              icon="view-dashboard"
              label="Dashboard"
            />
          </:menu>
        </.dm_left_menu_group>

        <.dm_left_menu_group active={to_string(@active_nav)}>
          <:title>Secrets</:title>
          <:menu id="secrets" to={~p"/admin/secrets"}>
            <.sidebar_menu_content
              id="sidebar-menu-secrets"
              icon="key-variant"
              label="Secrets"
            />
          </:menu>
          <:menu id="rotators" to={~p"/admin/rotators"}>
            <.sidebar_menu_content
              id="sidebar-menu-rotators"
              icon="rotate-3d-variant"
              label="Rotators"
            />
          </:menu>
          <:menu id="engines" to={~p"/admin/engines"}>
            <.sidebar_menu_content
              id="sidebar-menu-engines"
              icon="cog"
              label="Engines"
            />
          </:menu>
          <:menu id="rotations" to={~p"/admin/rotations"}>
            <.sidebar_menu_content
              id="sidebar-menu-rotations"
              icon="history"
              label="Rotation Logs"
            />
          </:menu>
          <:menu id="leases" to={~p"/admin/leases"}>
            <.sidebar_menu_content
              id="sidebar-menu-leases"
              icon="clock-outline"
              label="Leases"
            />
          </:menu>
        </.dm_left_menu_group>

        <.dm_left_menu_group active={to_string(@active_nav)}>
          <:title>Access Control</:title>
          <:menu id="policies" to={~p"/admin/policies"}>
            <.sidebar_menu_content
              id="sidebar-menu-policies"
              icon="shield-check"
              label="Policies"
            />
          </:menu>
          <:menu id="approles" to={~p"/admin/approles"}>
            <.sidebar_menu_content
              id="sidebar-menu-approles"
              icon="account-group"
              label="AppRoles"
            />
          </:menu>
          <:menu id="agents" to={~p"/admin/agents"}>
            <.sidebar_menu_content
              id="sidebar-menu-agents"
              icon="server"
              label="Agents"
            />
          </:menu>
          <:menu id="pending_agents" to={~p"/admin/pending-agents"}>
            <.sidebar_menu_content
              id="sidebar-menu-pending_agents"
              icon="server-plus"
              label="Pending Agents"
            />
          </:menu>
          <:menu id="cli_access" to={~p"/admin/cli-access"}>
            <.sidebar_menu_content
              id="sidebar-menu-cli_access"
              icon="console"
              label="CLI Access"
            />
          </:menu>
        </.dm_left_menu_group>

        <.dm_left_menu_group active={to_string(@active_nav)}>
          <:title>Security</:title>
          <:menu id="audit" to={~p"/admin/audit"}>
            <.sidebar_menu_content
              id="sidebar-menu-audit"
              icon="eye"
              label="Audit Log"
            />
          </:menu>
        </.dm_left_menu_group>

        <.dm_left_menu_group active={to_string(@active_nav)}>
          <:title>PKI</:title>
          <:menu id="pki_overview" to={~p"/admin/pki"}>
            <.sidebar_menu_content
              id="sidebar-menu-pki_overview"
              icon="chart-box-outline"
              label="Overview"
            />
          </:menu>
          <:menu id="pki_ca_list" to={~p"/admin/pki/ca"}>
            <.sidebar_menu_content
              id="sidebar-menu-pki_ca_list"
              icon="shield-key-outline"
              label="CA List"
            />
          </:menu>
          <:menu id="pki_certificates" to={~p"/admin/pki/certificates"}>
            <.sidebar_menu_content
              id="sidebar-menu-pki_certificates"
              icon="certificate-outline"
              label="Certificate List"
            />
          </:menu>
          <:menu id="pki_certificates_issue" to={~p"/admin/pki/certificates/issue"}>
            <.sidebar_menu_content
              id="sidebar-menu-pki_certificates_issue"
              icon="file-sign"
              label="Issue Certificate"
            />
          </:menu>
          <:menu id="pki_csr" to={~p"/admin/pki/csr"}>
            <.sidebar_menu_content
              id="sidebar-menu-pki_csr"
              icon="file-document-edit-outline"
              label="CSR Management"
            />
          </:menu>
          <:menu id="pki_csr_upload" to={~p"/admin/pki/csr/upload"}>
            <.sidebar_menu_content
              id="sidebar-menu-pki_csr_upload"
              icon="upload"
              label="Upload CSR"
            />
          </:menu>
          <:menu id="pki_search" to={~p"/admin/pki/search"}>
            <.sidebar_menu_content
              id="sidebar-menu-pki_search"
              icon="magnify"
              label="Search"
            />
          </:menu>
          <:menu id="pki_analytics" to={~p"/admin/pki/analytics"}>
            <.sidebar_menu_content
              id="sidebar-menu-pki_analytics"
              icon="chart-line"
              label="Analytics"
            />
          </:menu>
        </.dm_left_menu_group>

        <.dm_left_menu_group active={to_string(@active_nav)}>
          <:title>Infrastructure</:title>
          <:menu id="cluster" to={~p"/admin/cluster"}>
            <.sidebar_menu_content
              id="sidebar-menu-cluster"
              icon="server-network"
              label="Cluster"
            />
          </:menu>
          <:menu id="templates" to={~p"/admin/templates"}>
            <.sidebar_menu_content
              id="sidebar-menu-templates"
              icon="file-document-outline"
              label="Templates"
            />
          </:menu>
          <:menu id="alerts" to={~p"/admin/alerts"}>
            <.sidebar_menu_content
              id="sidebar-menu-alerts"
              icon="bell"
              label="Alerts"
            />
          </:menu>
          <:menu id="performance" to={~p"/admin/performance"}>
            <.sidebar_menu_content
              id="sidebar-menu-performance"
              icon="chart-bar"
              label="Performance"
            />
          </:menu>
        </.dm_left_menu_group>
      </:menu>
    </.dm_left_menu>
  </div>
  <div class="admin-sidebar-footer flex shrink-0 justify-end border-t border-secondary-content/20">
    <.dm_tooltip
      :let={trigger_attrs}
      id="admin-sidebar-toggle-hint"
      content="Toggle sidebar"
      position="right"
    >
      <.dm_btn
        id="admin-sidebar-toggle"
        variant="ghost"
        size="sm"
        shape="square"
        class="text-secondary-content"
        data-sidebar-toggle
        aria-controls="admin-sidebar"
        aria-expanded="true"
        aria-label="Collapse sidebar"
        {trigger_attrs}
      >
        <.dm_mdi name="chevron-left" class="admin-sidebar-collapse-icon h-5 w-5 shrink-0" />
        <.dm_mdi name="chevron-right" class="admin-sidebar-expand-icon h-5 w-5 shrink-0" />
      </.dm_btn>
    </.dm_tooltip>
  </div>
</aside>
