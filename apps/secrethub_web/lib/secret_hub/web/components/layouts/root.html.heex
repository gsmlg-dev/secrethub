<!DOCTYPE html>
<html lang="en" data-theme="sunshine">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="SecretHub">
      {assigns[:page_title]}
    </.live_title>
    <link
      phx-track-static
      rel="stylesheet"
      href={DuskmoonBundler.static_path(@conn, "/assets/css/app.css", profile: :secrethub_web)}
    />
    <script>
      // Set theme before page loads to prevent flash
      (function() {
        const theme = localStorage.getItem("theme") || "sunshine";
        if (theme && theme !== "default") {
          document.documentElement.setAttribute("data-theme", theme);
        } else {
          document.documentElement.removeAttribute("data-theme");
        }
      })();
    </script>
    <script
      defer
      phx-track-static
      type="module"
      src={DuskmoonBundler.static_path(@conn, "/assets/js/app.js", profile: :secrethub_web)}
    >
    </script>
  </head>
  <body class="bg-surface text-on-surface">
    {@inner_content}
  </body>
</html>
