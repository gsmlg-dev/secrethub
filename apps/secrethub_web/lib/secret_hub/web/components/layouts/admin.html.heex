<div class="min-h-screen flex bg-surface text-on-surface">
  <!-- Sidebar -->
  <aside
    id="admin-sidebar"
    phx-hook="AdminSidebar"
    data-collapsed="false"
    class="admin-sidebar sticky top-0 flex h-dvh w-72 shrink-0 flex-col bg-secondary text-secondary-content"
  >
    <div class="admin-sidebar-brand shrink-0 px-9 py-6">
      <.dm_link
        navigate={~p"/admin/dashboard"}
        class="flex items-center gap-2 text-secondary-content"
      >
        <.dm_mdi name="shield-lock" class="h-8 w-8 shrink-0" color="currentcolor" />
        <span class="admin-sidebar-label text-xl font-bold uppercase">SecretHub</span>
      </.dm_link>
      <div class="admin-sidebar-version ml-10 mt-1">
        <.version_badge id="sidebar-version" size="sm" class="normal-case" />
      </div>
    </div>
    <div class="admin-sidebar-scroll min-h-0 flex-1 overflow-x-hidden overflow-y-auto overscroll-contain">
      <.dm_left_menu
        id="admin-sidebar-menu"
        size="md"
        active={to_string(@active_nav)}
        class="bg-secondary text-secondary-content"
      >
        <:menu>
          <.dm_left_menu_group active={to_string(@active_nav)}>
            <:title>Overview</:title>
            <:menu id="dashboard" to={~p"/admin/dashboard"}>
              <.dm_mdi name="view-dashboard" class="w-5 h-5" />
              <span class="admin-sidebar-label">Dashboard</span>
            </:menu>
          </.dm_left_menu_group>

          <.dm_left_menu_group active={to_string(@active_nav)}>
            <:title>Secrets</:title>
            <:menu id="secrets" to={~p"/admin/secrets"}>
              <.dm_mdi name="key-variant" class="w-5 h-5" />
              <span class="admin-sidebar-label">Secrets</span>
            </:menu>
            <:menu id="rotators" to={~p"/admin/rotators"}>
              <.dm_mdi name="rotate-3d-variant" class="w-5 h-5" />
              <span class="admin-sidebar-label">Rotators</span>
            </:menu>
            <:menu id="engines" to={~p"/admin/engines"}>
              <.dm_mdi name="cog" class="w-5 h-5" />
              <span class="admin-sidebar-label">Engines</span>
            </:menu>
            <:menu id="rotations" to={~p"/admin/rotations"}>
              <.dm_mdi name="history" class="w-5 h-5" />
              <span class="admin-sidebar-label">Rotation Logs</span>
            </:menu>
            <:menu id="leases" to={~p"/admin/leases"}>
              <.dm_mdi name="clock-outline" class="w-5 h-5" />
              <span class="admin-sidebar-label">Leases</span>
            </:menu>
          </.dm_left_menu_group>

          <.dm_left_menu_group active={to_string(@active_nav)}>
            <:title>Access Control</:title>
            <:menu id="policies" to={~p"/admin/policies"}>
              <.dm_mdi name="shield-check" class="w-5 h-5" />
              <span class="admin-sidebar-label">Policies</span>
            </:menu>
            <:menu id="approles" to={~p"/admin/approles"}>
              <.dm_mdi name="account-group" class="w-5 h-5" />
              <span class="admin-sidebar-label">AppRoles</span>
            </:menu>
            <:menu id="agents" to={~p"/admin/agents"}>
              <.dm_mdi name="server" class="w-5 h-5" />
              <span class="admin-sidebar-label">Agents</span>
            </:menu>
            <:menu id="pending_agents" to={~p"/admin/pending-agents"}>
              <.dm_mdi name="server-plus" class="w-5 h-5" />
              <span class="admin-sidebar-label">Pending Agents</span>
            </:menu>
            <:menu id="cli_access" to={~p"/admin/cli-access"}>
              <.dm_mdi name="console" class="w-5 h-5" />
              <span class="admin-sidebar-label">CLI Access</span>
            </:menu>
          </.dm_left_menu_group>

          <.dm_left_menu_group active={to_string(@active_nav)}>
            <:title>Security</:title>
            <:menu id="audit" to={~p"/admin/audit"}>
              <.dm_mdi name="eye" class="w-5 h-5" />
              <span class="admin-sidebar-label">Audit Log</span>
            </:menu>
          </.dm_left_menu_group>

          <.dm_left_menu_group active={to_string(@active_nav)}>
            <:title>PKI</:title>
            <:menu id="pki_overview" to={~p"/admin/pki"}>
              <.dm_mdi name="chart-box-outline" class="w-5 h-5" />
              <span class="admin-sidebar-label">Overview</span>
            </:menu>
            <:menu id="pki_ca_list" to={~p"/admin/pki/ca"}>
              <.dm_mdi name="shield-key-outline" class="w-5 h-5" />
              <span class="admin-sidebar-label">CA List</span>
            </:menu>
            <:menu id="pki_certificates" to={~p"/admin/pki/certificates"}>
              <.dm_mdi name="certificate-outline" class="w-5 h-5" />
              <span class="admin-sidebar-label">Certificate List</span>
            </:menu>
            <:menu id="pki_certificates_issue" to={~p"/admin/pki/certificates/issue"}>
              <.dm_mdi name="file-sign" class="w-5 h-5" />
              <span class="admin-sidebar-label">Issue Certificate</span>
            </:menu>
            <:menu id="pki_csr" to={~p"/admin/pki/csr"}>
              <.dm_mdi name="file-document-edit-outline" class="w-5 h-5" />
              <span class="admin-sidebar-label">CSR Management</span>
            </:menu>
            <:menu id="pki_csr_upload" to={~p"/admin/pki/csr/upload"}>
              <.dm_mdi name="upload" class="w-5 h-5" />
              <span class="admin-sidebar-label">Upload CSR</span>
            </:menu>
            <:menu id="pki_search" to={~p"/admin/pki/search"}>
              <.dm_mdi name="magnify" class="w-5 h-5" />
              <span class="admin-sidebar-label">Search</span>
            </:menu>
            <:menu id="pki_analytics" to={~p"/admin/pki/analytics"}>
              <.dm_mdi name="chart-line" class="w-5 h-5" />
              <span class="admin-sidebar-label">Analytics</span>
            </:menu>
          </.dm_left_menu_group>

          <.dm_left_menu_group active={to_string(@active_nav)}>
            <:title>Infrastructure</:title>
            <:menu id="cluster" to={~p"/admin/cluster"}>
              <.dm_mdi name="server-network" class="w-5 h-5" />
              <span class="admin-sidebar-label">Cluster</span>
            </:menu>
            <:menu id="templates" to={~p"/admin/templates"}>
              <.dm_mdi name="file-document-outline" class="w-5 h-5" />
              <span class="admin-sidebar-label">Templates</span>
            </:menu>
            <:menu id="alerts" to={~p"/admin/alerts"}>
              <.dm_mdi name="bell" class="w-5 h-5" />
              <span class="admin-sidebar-label">Alerts</span>
            </:menu>
            <:menu id="performance" to={~p"/admin/performance"}>
              <.dm_mdi name="chart-bar" class="w-5 h-5" />
              <span class="admin-sidebar-label">Performance</span>
            </:menu>
          </.dm_left_menu_group>
        </:menu>
      </.dm_left_menu>
    </div>
    <div class="admin-sidebar-footer flex shrink-0 justify-end border-t border-secondary-content/20">
      <.dm_tooltip
        :let={trigger_attrs}
        id="admin-sidebar-toggle-hint"
        content="Toggle sidebar"
        position="right"
      >
        <.dm_btn
          id="admin-sidebar-toggle"
          variant="ghost"
          size="sm"
          shape="square"
          class="text-secondary-content"
          data-sidebar-toggle
          aria-controls="admin-sidebar"
          aria-expanded="true"
          aria-label="Collapse sidebar"
          {trigger_attrs}
        >
          <.dm_mdi name="chevron-left" class="admin-sidebar-collapse-icon h-5 w-5 shrink-0" />
          <.dm_mdi name="chevron-right" class="admin-sidebar-expand-icon h-5 w-5 shrink-0" />
        </.dm_btn>
      </.dm_tooltip>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="min-w-0 flex-1 flex flex-col min-h-screen bg-surface text-on-surface">
    <.dm_actionbar>
      <:left>
        <h1 class="text-2xl font-semibold">{@page_title || "Admin"}</h1>
      </:left>
      <:right>
        <.dm_theme_switcher id="admin-theme-toggle" />
      </:right>
    </.dm_actionbar>

    <.vault_sealed_banner vault_status={assigns[:vault_status]} />

    <div class="flex-1 p-6 overflow-auto bg-surface">
      <.flash_group flash={@flash} />
      {@inner_content}
    </div>
  </main>
</div>
