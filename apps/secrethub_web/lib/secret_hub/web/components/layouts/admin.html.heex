<div class="min-h-screen flex bg-surface text-on-surface">
  <!-- Sidebar -->
  {live_render(@socket, SecretHub.Web.AdminSidebarLive,
    id: "admin-sidebar-live",
    sticky: true,
    container: {:div, class: "contents"},
    session: %{"active_nav" => to_string(@active_nav)}
  )}

  <!-- Main Content -->
  <main
    id="admin-main"
    phx-hook="AdminSidebarNavigation"
    data-active-nav={to_string(@active_nav)}
    class="min-w-0 flex-1 flex flex-col min-h-screen bg-surface text-on-surface"
  >
    <.dm_actionbar>
      <:left>
        <h1 class="text-2xl font-semibold">{@page_title || "Admin"}</h1>
      </:left>
      <:right>
        <.dm_theme_switcher id="admin-theme-toggle" />
      </:right>
    </.dm_actionbar>

    <.vault_sealed_banner vault_status={assigns[:vault_status]} />

    <div class="flex-1 p-6 overflow-auto bg-surface">
      <.flash_group flash={@flash} />
      {@inner_content}
    </div>
  </main>
</div>
