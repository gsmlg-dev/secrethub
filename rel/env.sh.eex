#!/bin/sh
# The qualified single-node profile does not expose Erlang distribution.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
# VM crash dumps can include secrets from process heaps.
export ERL_CRASH_DUMP=/dev/null
<%= if @release.name == :secrethub_agent do %>
# Run public SSH lookups before cookie/private directories, runtime config or startup.
case "$RELEASE_COMMAND" in
  fetch-ssh-keys|fetch-ssh-host-keys)
    export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} +fnu"
    exec "$REL_VSN_DIR/elixir" \
      --boot "$REL_VSN_DIR/start_clean" \
      --boot-var RELEASE_LIB "$RELEASE_ROOT/lib" \
      --eval 'SecretHub.Agent.SSH.Helper.main(System.argv())' -- "$@"
    ;;
esac
# Run offline commands before runtime configuration or Agent startup.
if [ "$RELEASE_COMMAND" = "config" ]; then
  exec "$REL_VSN_DIR/elixir" \
    --boot "$REL_VSN_DIR/start_clean" \
    --boot-var RELEASE_LIB "$RELEASE_ROOT/lib" \
    --eval 'SecretHub.Agent.ConfigCLI.main(tl(System.argv()))' -- "$@"
fi
<% end %>
