@echo off
<%= if @release.name == :secrethub_agent do %>
if not defined RELEASE_DISTRIBUTION (set RELEASE_DISTRIBUTION=none)
set ERL_CRASH_DUMP=NUL

if "%~1" == "config" (
  call "!REL_VSN_DIR!\elixir.bat" ^
    --boot "!REL_VSN_DIR!\start_clean" ^
    --boot-var RELEASE_LIB "!RELEASE_ROOT!\lib" ^
    --eval "SecretHub.Agent.ConfigCLI.main(tl(System.argv()))" -- %*
  exit /b !errorlevel!
)
<% end %>
