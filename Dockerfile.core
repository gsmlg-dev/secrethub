FROM elixir:1.18.4-otp-28-alpine@sha256:d8313656ddc1e96c0ee90e680e430c861abd00082ad16ea4a532163dc1031f21 AS builder
RUN apk add --no-cache build-base git
WORKDIR /app
ENV MIX_ENV=prod
RUN mix local.hex --force && mix local.rebar --force
COPY mix.exs mix.lock ./
COPY config ./config
COPY apps ./apps
COPY rel ./rel
RUN mix deps.get --only prod && mix deps.compile
COPY package.json package-lock.json ./
RUN mix npm.ci
ARG SECRET_HUB_GIT_REF
ARG SECRET_HUB_GIT_SHA
ARG SECRET_HUB_BUILD_TIME
ENV SECRET_HUB_GIT_REF=$SECRET_HUB_GIT_REF SECRET_HUB_GIT_SHA=$SECRET_HUB_GIT_SHA SECRET_HUB_BUILD_TIME=$SECRET_HUB_BUILD_TIME
RUN mix compile --warnings-as-errors
RUN mix duskmoon_bundler.build secrethub_web --tailwind
RUN mix phx.digest --no-compile
RUN mix release secrethub_core

FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8 AS runtime
RUN apk add --no-cache openssl ncurses-libs ca-certificates curl socat libgcc libstdc++
RUN addgroup -g 1001 -S secrethub && adduser -D -u 1001 -G secrethub -S secrethub
WORKDIR /app
COPY --from=builder --chown=secrethub:secrethub /app/_build/prod/rel/secrethub_core ./
ENV HOME=/app MIX_ENV=prod RELEASE_DISTRIBUTION=none ERL_CRASH_DUMP=/dev/null
RUN mkdir -p /app/tmp /var/lib/secrethub /var/run/secrethub && chown secrethub:secrethub /app/tmp /var/lib/secrethub /var/run/secrethub
ENV TMPDIR=/app/tmp
ENV PHX_SERVER=true PORT=4664
EXPOSE 4665 4668
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD curl -fsS http://127.0.0.1:4664/v1/sys/health/live >/dev/null || exit 1
USER secrethub
ENTRYPOINT ["/app/bin/secrethub_core"]
CMD ["start"]
LABEL org.opencontainers.image.source="https://github.com/gsmlg-dev/secrethub" org.opencontainers.image.licenses="MIT"
