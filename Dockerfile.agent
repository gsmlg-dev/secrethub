FROM elixir:1.18.4-otp-28-alpine@sha256:d8313656ddc1e96c0ee90e680e430c861abd00082ad16ea4a532163dc1031f21 AS builder
RUN apk add --no-cache build-base git
WORKDIR /app
ENV MIX_ENV=prod
RUN mix local.hex --force && mix local.rebar --force
COPY mix.exs mix.lock ./
COPY config ./config
COPY apps ./apps
COPY rel ./rel
RUN mix deps.get --only prod && mix deps.compile
RUN mix compile --warnings-as-errors
RUN mix release secrethub_agent

FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8 AS runtime
RUN apk add --no-cache openssl ncurses-libs ca-certificates curl socat libgcc libstdc++
RUN addgroup -g 1002 -S secrethub && adduser -D -u 1002 -G secrethub -S secrethub
WORKDIR /app
COPY --from=builder --chown=secrethub:secrethub /app/_build/prod/rel/secrethub_agent ./
ENV HOME=/app MIX_ENV=prod RELEASE_DISTRIBUTION=none ERL_CRASH_DUMP=/dev/null
RUN mkdir -p /app/tmp /var/lib/secrethub /var/run/secrethub && chown secrethub:secrethub /app/tmp /var/lib/secrethub /var/run/secrethub
ENV TMPDIR=/app/tmp
ENV SECRET_HUB_AGENT_STATE_DIR=/var/lib/secrethub/agent SECRET_HUB_AGENT_SOCKET_PATH=/var/run/secrethub/agent.sock SECRET_HUB_CLIENT_AUTH_BUNDLE_DIR=/var/lib/secrethub/pki/client-auth
RUN mkdir -p /var/lib/secrethub/agent /var/lib/secrethub/pki/client-auth && chown -R secrethub:secrethub /var/lib/secrethub
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD printf '%s\n' '{"request_id":"container-health","action":"ping","params":{}}' | socat -T2 - UNIX-CONNECT:"$SECRET_HUB_AGENT_SOCKET_PATH" | grep -q 'pong' || exit 1
USER secrethub
ENTRYPOINT ["/app/bin/secrethub_agent"]
CMD ["start"]
LABEL org.opencontainers.image.source="https://github.com/gsmlg-dev/secrethub" org.opencontainers.image.licenses="MIT"
